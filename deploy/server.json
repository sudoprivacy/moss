{
  "server": {
    "host": "0.0.0.0",
    "port": 43127,
    "advertisedHost": "0.0.0.0"
  },
  "auth": {
    "mode": "local",
    "tokenTtlSec": 86400
  },
  "bootstrapAdmin": {
    "username": "admin",
    "password": "admin"
  },
  "runtimeDefaults": {
    "type": "docker",
    "engine": "scode",
    "dockerImage": "my-moss-runtime:v1",
    "dockerMode": "session",
    "scodePath": "/usr/local/bin/scode",
    "scodeVersion": "v0.1.11",
    "idleTimeoutMs": 600000,
    "maxSessions": 32
  },
  "storage": {
    "rootDir": "./data",
    "dbPath": "./data/moss.db",
    "transcriptDir": "./data/transcripts",
    "runtimeDir": "./data/runtime"
  },
  "docker": {
    "stopTimeoutSec": 10,
    "labels": {},
    "network": "moss-network",
    "containerMode": "user",
    "maxSessionsPerUser": 5,
    "userContainerIdleTimeoutMs": 1200000,
    "execKillGraceMs": 5000,
    "user": {
      "pidsLimit": 512,
      "memory": "4g",
      "cpus": "2",
      "nofile": 4096
    }
  },
  "recovery": {
    "startupPolicy": "reattach-or-resume",
    "heartbeatTimeoutMs": 30000,
    "reattachProbeTimeoutMs": 3000,
    "resumeOnMissingRuntime": true
  },
  "logging": {
    "level": "info"
  },
  "cabin": {
    "enabled": false,
    "tokenSecret": "dev-cabin-token-secret",
