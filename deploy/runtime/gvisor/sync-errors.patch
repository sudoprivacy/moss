diff --git a/pkg/sentry/fsimpl/gofer/gofer.go b/pkg/sentry/fsimpl/gofer/gofer.go
index e0af1e5..85341a6 100644
--- a/pkg/sentry/fsimpl/gofer/gofer.go
+++ b/pkg/sentry/fsimpl/gofer/gofer.go
@@ -2330,11 +2330,11 @@ func (d *dentry) syncRemoteFileLocked(ctx context.Context, dataOnly bool) error
-	wh := d.inode.writeHandle()
-	if dataOnly {
-		wh.syncData(ctx)
-	} else {
-		wh.sync(ctx)
-	}
-	rh := d.inode.readHandle()
-	if dataOnly {
-		rh.syncData(ctx)
-	} else {
-		rh.sync(ctx)
+	var firstErr error
+	for _, h := range [2]handle{d.inode.writeHandle(), d.inode.readHandle()} {
+		var err error
+		if dataOnly {
+			err = h.syncData(ctx)
