# =============================================================================
# server.Dockerfile.local — fully self-contained moss server image
# =============================================================================
# Unlike deploy/server.Dockerfile (which only COPYs prebuilt artifacts produced
# by CI / a prior local `bun run build:node`), this variant BUILDS EVERYTHING
# from source inside the image, so a single `docker build` yields a correct
# linux/amd64 or linux/arm64 image with no host-side preparation:
#
#   - moss-server.mjs / direct-connect-session-runner.mjs / admin/dist  (bun)
#   - bin/wiki, bin/corpapp                                            (Go, target arch)
#   - native/nexus-napi/nexus-napi.node                                (Rust, target arch)
#   - bin/nexus/nexusd, bin/scode                                      (downloaded)
#
# The nexus-napi addon depends on the PRIVATE crate `nexus-vfs-client` from
# github.com/sudoprivacy/sudocode. To avoid baking a GitHub token into the
# build, this Dockerfile expects a LOCAL clone of that repo staged into the
# build context at ./.sudocode-build-context, and Cargo `[patch]`es the git
# dependency to that local path. Use deploy/build-server-local.sh, which
# clones/updates ~/sudocode and stages it automatically.
#
# Build:  deploy/build-server-local.sh [image-tag]
# =============================================================================

# --- Stage 0: runtime external deps (bun) ------------------------------------
# scripts/build.js marks @xenova/transformers / onnxruntime-node / sharp as
# --external (kept out of bin/moss-server.mjs to keep the bundle lean). They
# must therefore be resolvable from /app/node_modules at runtime, or the wiki
# embedder silently degrades to grep-only. Install just those into an isolated
# node_modules and COPY it into the runtime stage. (onnxruntime-node is a
# transitive dep of @xenova and is pulled in automatically.)
FROM oven/bun:1 AS runtime-deps
WORKDIR /deps
COPY deploy/runtime-deps.package.json package.json
RUN bun install

# --- Stage 0b: unzip the embedding model -------------------------------------
# The model ships in-repo as deploy/models/Xenova.zip (tracked via git-lfs). Its
# top level is Xenova/multilingual-e5-small/...; unzip it here and strip Mac junk
# so the runtime stage COPYs only the clean model tree (the zip + unzip tooling
# never land in the final image).
FROM debian:bookworm-slim AS model-stage
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
WORKDIR /m
COPY deploy/models/Xenova.zip ./Xenova.zip
RUN unzip -q Xenova.zip -d out \
    && rm -rf out/__MACOSX \
    && find out -name '.DS_Store' -delete \
    && find out -name '.cache' -type d -prune -exec rm -rf {} + \
    && test -f out/Xenova/multilingual-e5-small/onnx/model_quantized.onnx

# --- Stage 1: JS/TS bundles + admin frontend (bun) ---------------------------
FROM oven/bun:1 AS js-builder
WORKDIR /src
# Install root + admin deps first (better layer caching), then build.
COPY package.json bun.lock ./
COPY admin/package.json admin/bun.lock ./admin/
# vendor/ is copied by postinstall (copy-vendor.js); bring it in before install.
COPY vendor ./vendor
COPY scripts ./scripts
RUN bun install --frozen-lockfile || bun install
RUN cd admin && (bun install --frozen-lockfile || bun install)
# Now the full source and run the build (admin/dist + bin/*.mjs).
COPY . .
RUN bun run build:node
# build:node also builds Go CLIs for the BUILD host arch (wrong for a
# cross-platform image); the Go stage below rebuilds wiki/corpapp for the target
# arch and overrides them.

# --- Stage 2: Go CLIs cross-compiled for the target arch ---------------------
FROM golang:1.22-alpine AS go-builder
WORKDIR /src
ARG TARGETARCH
COPY cli ./cli
RUN test -n "$TARGETARCH" \
    && cd cli/wiki \
    && CGO_ENABLED=0 GOOS=linux GOARCH="$TARGETARCH" go build -ldflags="-s -w" -o /out/wiki . \
    && cd /src/cli/corpapp \
    && CGO_ENABLED=0 GOOS=linux GOARCH="$TARGETARCH" go build -ldflags="-s -w" -o /out/corpapp .

# --- Stage 3: nexus-napi (Rust) for the target arch --------------------------
# Uses the locally-staged sudocode clone (./.sudocode-build-context) via a Cargo
# [patch], so no GitHub token is needed for the private nexus-vfs-client dep.
# Base on rust:1-bookworm — Rust/cargo are preinstalled, so no rustup toolchain
# download (static.rust-lang.org) is needed. We build the addon with plain
# `cargo build` (the crate is crate-type=["cdylib"]; build.rs runs
# napi_build::setup()) and rename the resulting .so to nexus-napi.node — this
# avoids needing Node/npm/@napi-rs/cli at all, removing every flaky external
# download from this stage except the unavoidable crates.io fetch (hardened via
# the sparse protocol + retries below).
FROM rust:1-bookworm AS napi-builder
WORKDIR /src
ARG TARGETARCH
# Cargo network resilience: sparse crates.io protocol (plain HTTPS, no git index
# clone) + built-in retries survive the transient TLS drops the mirror throws.
ENV CARGO_NET_RETRY=10 CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse CARGO_HTTP_MULTIPLEXING=false
# Local sudocode clone (staged by build-server-local.sh).
COPY .sudocode-build-context /sudocode
# The napi crate sources.
COPY native/nexus-napi ./native/nexus-napi
# Redirect the git dependency to the local sudocode checkout. Cargo applies this
# [patch] to the `nexus-vfs-client` git dep regardless of its pinned rev, so the
# build uses whatever sudocode HEAD was staged into the context.
RUN printf '\n[patch."https://github.com/sudoprivacy/sudocode"]\nnexus-vfs-client = { path = "/sudocode/rust/crates/nexus-vfs-client" }\n' \
      >> native/nexus-napi/Cargo.toml
# Retry loop on top of CARGO_NET_RETRY: a full TLS handshake drop to crates.io
# can still abort a run; retrying converges (cargo caches what it fetched).
# napi-rs cdylib output is lib<crate>.so → rename to <binaryName>.node.
RUN cd native/nexus-napi \
    && case "$TARGETARCH" in \
         amd64) RUST_TARGET="x86_64-unknown-linux-gnu" ;; \
         arm64) RUST_TARGET="aarch64-unknown-linux-gnu" ;; \
         *) echo "Unsupported TARGETARCH: $TARGETARCH" && exit 1 ;; \
       esac \
    && rustup target add "$RUST_TARGET" \
    && for i in 1 2 3 4 5; do \
         cargo build --release --target "$RUST_TARGET" && break \
         || { echo "cargo build attempt $i failed; retrying in 10s..."; sleep 10; }; \
       done \
    && cp "target/$RUST_TARGET/release/libnexus_napi.so" nexus-napi.node \
    && test -f nexus-napi.node || (echo "napi build failed after retries" && exit 1)
# Output: native/nexus-napi/nexus-napi.node

# --- Stage 4: downloaded binaries (nexusd-cluster, scode) --------------------
FROM debian:bookworm-slim AS dl
ARG NEXUS_VFS_VERSION=v0.1.0
ARG SCODE_VERSION=latest
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates tar \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /dl
# nexusd-cluster (Rust nexus daemon).
RUN case "$TARGETARCH" in \
      amd64) NEXUS_ARCH="x86_64" ;; \
      arm64) NEXUS_ARCH="aarch64" ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" && exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/nexi-lab/nexus-vfs/releases/download/${NEXUS_VFS_VERSION}/nexusd-cluster-linux-${NEXUS_ARCH}.tar.gz" -o nexus.tar.gz \
    && tar -xzf nexus.tar.gz \
    && mkdir -p /out/bin/nexus \
    && mv "nexusd-cluster-linux-${NEXUS_ARCH}/nexusd-cluster" /out/bin/nexus/nexusd \
    && chmod +x /out/bin/nexus/nexusd
# scode (resolve "latest" tag when not pinned).
RUN set -e; \
    case "$TARGETARCH" in \
      amd64) SCODE_ARCH="x64" ;; \
      arm64) SCODE_ARCH="arm64" ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" && exit 1 ;; \
    esac; \
    V="${SCODE_VERSION}"; \
    if [ "$V" = "latest" ]; then \
      V=$(curl -sI "https://github.com/sudoprivacy/sudocode/releases/latest" | grep -i "location:" | sed 's/.*tag\///' | tr -d '\r\n'); \
    fi; \
    echo "scode version: $V arch: $SCODE_ARCH"; \
    curl -fsSL "https://github.com/sudoprivacy/sudocode/releases/download/${V}/scode-linux-${SCODE_ARCH}.tar.gz" -o scode.tar.gz; \
    tar -xzf scode.tar.gz; \
    mv "scode-linux-${SCODE_ARCH}/scode" /out/bin/scode; \
    chmod +x /out/bin/scode

# --- Stage 5: runtime image --------------------------------------------------
# Use Debian trixie (glibc 2.41) rather than bookworm (glibc 2.36): current
# scode releases (v0.1.10+) are linked against GLIBC_2.39 and fail to run on
# bookworm with "version `GLIBC_2.39' not found". Node 22 line is unchanged.
FROM node:22-trixie-slim
# Let apt auto-retry transient mirror failures and download serially so a flaky
# proxy doesn't fail the whole layer.
RUN printf 'Acquire::Retries "20";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\nAcquire::Queue-Mode "access";\nAcquire::http::Pipeline-Depth "0";\n' > /etc/apt/apt.conf.d/80-retries
# Mirror fallback: try the default deb.debian.org first; only if it fails (e.g.
# the upstream mirror is unreachable from this network) rewrite the trixie
# sources to mirrors.aliyun.com and retry. node:22-trixie-slim uses the deb822
# format at /etc/apt/sources.list.d/debian.sources, so rewrite the URIs there.
RUN if ! apt-get update; then \
      echo "deb.debian.org apt-get update failed; switching to mirrors.aliyun.com"; \
      sed -i 's|http://deb.debian.org|https://mirrors.aliyun.com|g; s|https://deb.debian.org|https://mirrors.aliyun.com|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
      sed -i 's|http://deb.debian.org|https://mirrors.aliyun.com|g; s|https://deb.debian.org|https://mirrors.aliyun.com|g' \
        /etc/apt/sources.list 2>/dev/null || true; \
      apt-get update; \
    fi
# Docker CLI + LibreOffice deps. Retry loop converges past transient mirror 502s
# (apt cache persists within the RUN). jq is required by the OAuth2 credential script.
RUN apt-get update \
    && for i in 1 2 3 4 5 6 7 8; do \
         apt-get install -y --no-install-recommends \
           curl \
           ca-certificates \
           gnupg \
           lsb-release \
           unzip \
           jq \
           tzdata \
           # LibreOffice 依赖
           libxinerama1 \
           libcairo2 \
           libcups2 \
           libxrandr2 \
           libxdamage1 \
           libxtst6 \
           libgtk-3-0 \
           libgl1 \
           libglib2.0-0 \
           libsm6 \
           libice6 \
           libxrender1 \
           libfontconfig1 \
           libdbus-1-3 \
           libxi6 \
           # LibreOffice 26.2 需要 OpenSSL 3 和 NSS
           libssl3 \
           libnss3 \
           libnspr4 \
         && break || { echo "apt install attempt $i failed; retrying in 10s..."; sleep 10; }; \
       done \
    && command -v jq >/dev/null || (echo "jq not installed after retries" && exit 1) \
    && LIBDIR="$(dirname "$(ldconfig -p | awk '/libssl.so.3/{print $NF; exit}')")" \
    && ln -sf "$LIBDIR/libssl.so.3" "$LIBDIR/libssl3.so" \
    && ln -sf "$LIBDIR/libcrypto.so.3" "$LIBDIR/libcrypto3.so" \
    && rm -rf /var/lib/apt/lists/*

# Run the whole server in China time (Asia/Shanghai): logs, timestamps, and cron
# wall-clock all use CST. Without this the container defaults to UTC, so a cron
# like "9-17" fires 9-17 UTC (= evening in China). tzdata installed above.
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo 'Asia/Shanghai' > /etc/timezone

# Docker CLI (retry + domestic mirror fallback)
RUN for i in 1 2 3; do \
        if curl -fsSL --connect-timeout 30 https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg 2>/dev/null; then \
            break; \
        elif curl -fsSL --connect-timeout 30 https://mirrors.aliyun.com/docker-ce/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg 2>/dev/null; then \
            break; \
        else \
            echo "Retry $i: Failed to download Docker GPG key, waiting..."; sleep 5; \
        fi; \
    done \
    && [ -f /usr/share/keyrings/docker-archive-keyring.gpg ] || { echo "ERROR: Docker GPG key download failed"; exit 1; } \
    && DISTRO_CODENAME=$(/usr/bin/lsb_release -cs) \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian ${DISTRO_CODENAME} stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# LibreOffice + PDF tools (retry loop, same rationale as above)
RUN apt-get update \
    && for i in 1 2 3 4 5 6 7 8; do \
         apt-get install -y --no-install-recommends \
           libreoffice-writer libreoffice-core poppler-utils fonts-noto-cjk \
         && break || { echo "libreoffice install attempt $i failed; retrying in 10s..."; sleep 10; }; \
       done \
    && command -v soffice >/dev/null || (echo "libreoffice not installed after retries" && exit 1) \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV LIBREOFFICE_BIN=/usr/bin/soffice

WORKDIR /app

# Built JS/TS artifacts + admin frontend + assistants/skills (from js-builder).
COPY --from=js-builder /src/bin/moss-server.mjs ./bin/
COPY --from=js-builder /src/bin/direct-connect-session-runner.mjs ./bin/
COPY --from=js-builder /src/admin/dist/ ./admin/dist/
COPY --from=js-builder /src/assistants/ ./assistants/
COPY --from=js-builder /src/skills/ ./skills/
# nexus-napi loader + native addon (from napi-builder).
COPY --from=js-builder /src/native/nexus-napi/index.js /src/native/nexus-napi/index.d.ts ./native/nexus-napi/
COPY --from=napi-builder /src/native/nexus-napi/nexus-napi.node ./native/nexus-napi/
# Go CLIs cross-compiled for target arch (from go-builder).
COPY --from=go-builder /out/wiki ./bin/wiki
COPY --from=go-builder /out/corpapp ./bin/corpapp
# Downloaded binaries (from dl).
# nexusd lives in /app/bin/nexus/ (NOT /root/.moss/nexus/bin/) because
# docker-compose mounts the host ./.moss over /root/.moss and would shadow it;
# NexusManager.resolveBinary() falls back to <cwd>/bin/nexus/nexusd (cwd=/app).
COPY --from=dl /out/bin/nexus/nexusd ./bin/nexus/nexusd
COPY --from=dl /out/bin/scode ./bin/scode

RUN chmod +x ./bin/wiki ./bin/corpapp ./bin/scode ./bin/nexus/nexusd

# Runtime external deps (@xenova/transformers + onnxruntime-node + sharp), so
# the wiki embedder can import('@xenova/transformers') instead of degrading to
# grep-only. Lands at /app/node_modules (cwd=/app), the default resolution root.
COPY --from=runtime-deps /deps/node_modules ./node_modules

# Embedding model baked into the image at /app/models (NOT /root/.moss/models:
# docker-compose mounts the host ./.moss over /root/.moss and would shadow it).
# MOSS_MODELS_DIR points the embedder cache here. The model-stage unzipped the
# in-repo deploy/models/Xenova.zip to /m/out/Xenova/...
COPY --from=model-stage /m/out/Xenova /app/models/Xenova
ENV MOSS_MODELS_DIR=/app/models

EXPOSE 43127

CMD ["node", "bin/moss-server.mjs", "start"]
