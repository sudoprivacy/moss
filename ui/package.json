{
  "name": "claude-code-electron-mvp",
  "version": "0.0.3",
  "description": "Moss - AI coding agent desktop client",
  "author": "Moss AI Team",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:renderer": "vite build && mkdir -p dist/apps && cp -r src/apps/* dist/apps/ && mkdir -p dist/renderer/build && cp -r build/* dist/renderer/build/",
    "start": "vite build && electron .",
    "dev": "node scripts/dev.mjs start",
    "dev:renderer": "vite",
    "check": "node --check src/main.mjs && node --check src/preload.mjs && node --check src/app-preload.mjs && node --check scripts/dev.mjs && tsc --noEmit",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "release:win": "vite build && electron-builder --win --publish always",
    "release:mac": "vite build && electron-builder --mac --publish always",
    "install-app": "node -e \"const fs=require('fs');const os=require('os');const path=require('path');const s=process.argv[2];if(!s){console.log('Usage: npm run install-app <app-name>');process.exit(1);}const src='src/apps/'+s+'.html';const dst=path.join(os.homedir(),'.moss','generated-apps',s+'.html');fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('Installed:',dst);\""
  },
  "build": {
    "appId": "com.moss.ai",
    "productName": "Moss",
    "directories": {
      "output": "dist/installers",
      "buildResources": "build"
    },
    "icon": "build/icon",
    "dmg": {
      "background": null,
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "dist/renderer/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "electron-direct.mjs"
    ],
    "extraResources": [
      {
        "from": "src/apps",
        "to": "apps",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assistants",
        "to": "assistants",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "sudoprivacy",
      "repo": "moss"
    }
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.42",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@xmldom/xmldom": "^0.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.0",
    "semver": "^7.7.4",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "1.3.3",
    "xlsx-republish": "^0.20.3",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "40.8.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
