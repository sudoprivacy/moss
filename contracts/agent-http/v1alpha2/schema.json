{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudo.dev/agent-http/v1alpha2",
  "oneOf": [
    {
      "$ref": "#/$defs/SubmitAgentRun"
    },
    {
      "$ref": "#/$defs/AgentRun"
    }
  ],
  "$defs": {
    "SubmitAgentRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "agent-http.sudo.dev/v1alpha2"
        },
        "kind": {
          "const": "SubmitAgentRun"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "external_agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "execution_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "provider_session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "deadline_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "api_version",
        "kind",
        "invocation_id",
        "external_agent_id",
        "execution_revision",
        "query",
        "provider_session_id",
        "end_user",
        "deadline_at"
      ]
    },
    "AgentRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "agent-http.sudo.dev/v1alpha2"
        },
        "kind": {
          "const": "AgentRun"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "external_agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "execution_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provider_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "provider_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "status": {
          "enum": [
            "accepted",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "cancelled"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 128000
            }
          },
          "required": [
            "text"
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z_]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "api_version",
        "kind",
        "invocation_id",
        "request_digest",
        "external_agent_id",
        "execution_revision",
        "provider_run_id",
        "provider_session_id",
        "status",
        "sequence",
        "output",
        "error_code",
        "created_at",
        "updated_at"
      ]
    }
  }
}
