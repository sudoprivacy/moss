{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.sudo.dev/experimental/agent-catalog/v1alpha1",
  "definitions": {
    "CatalogCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming",
        "cancel",
        "resume",
        "idempotency",
        "version_pin",
        "human_approval",
        "trace_export"
      ],
      "properties": {
        "streaming": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "cancel": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "resume": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "idempotency": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "version_pin": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "human_approval": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "trace_export": {
          "enum": [
            "full",
            "partial",
            "none",
            "unknown"
          ]
        }
      }
    },
    "CatalogSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "catalog_id",
        "org_id",
        "zone_id",
        "owner_id",
        "name",
        "provider",
        "protocol",
        "external_agent_id",
        "endpoint",
        "connection_id",
        "credential_reference",
        "revision",
        "enabled",
        "availability",
        "adapter_version",
        "definition_available",
        "last_sync_at",
        "last_sync_status",
        "last_error",
        "warning_count",
        "created_at",
        "updated_at",
        "allowed_user_ids",
        "review_note"
      ],
      "properties": {
        "api_version": {
          "const": "agent-catalog.sudo.dev/v1alpha1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "provider": {
          "enum": [
            "dify",
            "custom_http"
          ]
        },
        "protocol": {
          "type": "string",
          "maxLength": 2048
        },
        "external_agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2048
        },
        "connection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "credential_reference": {
          "type": "string",
          "maxLength": 2048
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "unknown",
            "available",
            "unavailable"
          ]
        },
        "adapter_version": {
          "type": "string",
          "maxLength": 2048
        },
        "definition_available": {
          "type": "boolean"
        },
        "last_sync_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sync_status": {
          "enum": [
            "never",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_user_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 100
        },
        "review_note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "CatalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protocol",
        "external_agent_id",
        "source_revision",
        "revision_basis",
        "source_digest",
        "parameters_digest",
        "adapter_version",
        "endpoint",
        "input_profile",
        "output_profile",
        "capabilities",
        "user_ids",
        "data_scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "protocol": {
          "type": "string",
          "maxLength": 2048
        },
        "external_agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_basis": {
          "enum": [
            "provider_declared",
            "content_digest"
          ]
        },
        "source_digest": {
          "type": "string",
          "maxLength": 2048
        },
        "parameters_digest": {
          "type": "string",
          "maxLength": 2048
        },
        "adapter_version": {
          "type": "string",
          "maxLength": 2048
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2048
        },
        "input_profile": {
          "type": "string",
          "maxLength": 2048
        },
        "output_profile": {
          "type": "string",
          "maxLength": 2048
        },
        "capabilities": {
          "$ref": "#/definitions/CatalogCapabilities"
        },
        "user_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "maxItems": 100
        },
        "data_scope": {
          "enum": [
            "synthetic_only"
          ]
        }
      }
    },
    "CatalogValidationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_version",
        "source_revision",
        "binding_revision",
        "policy_digest",
        "snapshot_digest",
        "validated_at",
        "status",
        "checks",
        "warnings",
        "unsupported"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "rule_version": {
          "type": "string",
          "maxLength": 2048
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 1
        },
        "policy_digest": {
          "type": "string",
          "maxLength": 2048
        },
        "snapshot_digest": {
          "type": "string",
          "maxLength": 2048
        },
        "validated_at": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "valid"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 100
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 100
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 100
        }
      }
    },
    "CatalogChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "before",
        "after"
      ],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 2048
        },
        "before": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CatalogDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actor_id",
        "note",
        "at"
      ],
      "properties": {
        "action": {
          "enum": [
            "submitted",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "note": {
          "type": "string",
          "maxLength": 2048
        },
        "at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ImportCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "source_id",
        "catalog_id",
        "org_id",
        "revision",
        "status",
        "snapshot",
        "validation",
        "changes",
        "decisions",
        "created_at",
        "published_version",
        "publication_error",
        "publication_started_at"
      ],
      "properties": {
        "api_version": {
          "const": "agent-catalog.sudo.dev/v1alpha1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "pending_approval",
            "approved",
            "rejected",
            "publishing",
            "publication_unknown",
            "published",
            "archived"
          ]
        },
        "snapshot": {
          "$ref": "#/definitions/CatalogSnapshot"
        },
        "validation": {
          "$ref": "#/definitions/CatalogValidationReport"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogChange"
          },
          "maxItems": 100
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogDecision"
          },
          "maxItems": 1000
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "published_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_started_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SourceSyncResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "source_id",
        "org_id",
        "started_at",
        "completed_at",
        "status",
        "candidate_id",
        "reused",
        "error"
      ],
      "properties": {
        "api_version": {
          "const": "agent-catalog.sudo.dev/v1alpha1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "started_at": {
          "type": "integer",
          "minimum": 0
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed"
          ]
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reused": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CatalogAuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "org_id",
        "zone_id",
        "actor_id",
        "at",
        "action",
        "catalog_id",
        "source_id",
        "candidate_id",
        "version",
        "task_id",
        "result",
        "reason"
      ],
      "properties": {
        "api_version": {
          "const": "agent-catalog.sudo.dev/v1alpha1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "maxLength": 2048
        },
        "catalog_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CatalogVersionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "version",
        "source_id",
        "candidate_id",
        "spec_digest",
        "source_digest",
        "lifecycle",
        "provenance"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "version": {
          "type": "string",
          "maxLength": 2048
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec_digest": {
          "type": "string",
          "maxLength": 2048
        },
        "source_digest": {
          "type": "string",
          "maxLength": 2048
        },
        "lifecycle": {
          "enum": [
            "published",
            "deprecated",
            "archived"
          ]
        },
        "provenance": {
          "enum": [
            "candidate",
            "legacy_adopted"
          ]
        }
      }
    }
  }
}
