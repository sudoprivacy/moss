        "user_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "maxItems": 100
        },
        "data_scope": {
          "enum": [
            "synthetic_only"
          ]
