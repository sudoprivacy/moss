{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.sudo.dev/experimental/agent-catalog/v1alpha1",
  "definitions": {
    "CatalogCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming",
        "cancel",
        "resume",
        "idempotency",
        "version_pin",
        "human_approval",
        "trace_export"
      ],
      "properties": {
        "streaming": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "cancel": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "resume": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "idempotency": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "version_pin": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "human_approval": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "provider_dependent",
            "unknown"
          ]
        },
        "trace_export": {
          "enum": [
            "full",
            "partial",
            "none",
            "unknown"
          ]
        }
      }
    },
    "CatalogSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "id",
        "catalog_id",
        "org_id",
        "zone_id",
        "owner_id",
        "name",
        "provider",
        "protocol",
        "external_agent_id",
        "endpoint",
        "connection_id",
        "credential_reference",
        "revision",
        "enabled",
        "availability",
        "adapter_version",
        "definition_available",
        "last_sync_at",
        "last_sync_status",
        "last_error",
        "warning_count",
        "created_at",
        "updated_at",
        "allowed_user_ids",
        "review_note"
      ],
      "properties": {
        "api_version": {
          "const": "agent-catalog.sudo.dev/v1alpha1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "provider": {
          "enum": [
            "dify",
            "custom_http"
          ]
        },
        "protocol": {
          "type": "string",
          "maxLength": 2048
        },
        "external_agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 2048
        },
        "connection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "credential_reference": {
          "type": "string",
          "maxLength": 2048
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "unknown",
            "available",
            "unavailable"
          ]
        },
        "adapter_version": {
          "type": "string",
          "maxLength": 2048
        },
        "definition_available": {
          "type": "boolean"
        },
        "last_sync_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sync_status": {
          "enum": [
            "never",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_user_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 100
        },
        "review_note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "CatalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protocol",
        "external_agent_id",
